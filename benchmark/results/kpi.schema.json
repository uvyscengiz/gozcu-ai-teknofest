{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/uvyscengiz/gozcu-ai-teknofest/benchmark/results/kpi.schema.json",
  "title": "Gözcü benchmark çıktısı (benchmark/results/kpi.json)",
  "description": "Dosya HEM klip başına HEM toplu sonuç taşır: `clips[]` her etiketli klip için bir kayıt, `aggregate` ise yalnız `status == \"measured\"` kliplerin ortalaması. Ölçülemeyen her KPI `null` — `0` değil. Üreten: benchmark/run.py, okuyan: benchmark/report.py.",
  "type": "object",
  "required": ["schema_version", "generated_at", "ground_truth", "clips", "aggregate"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "description": "ISO-8601, UTC."},
    "ground_truth": {
      "type": "object",
      "description": "Etiket dosyasının durumu. `unlabelled` olaylı ama penceresi henüz işaretlenmemiş klipleri sayar; onlar zaman sapmasına girmez.",
      "required": ["clips", "labelled", "unlabelled", "no_incident"],
      "additionalProperties": false,
      "properties": {
        "clips": {"type": "integer", "minimum": 0},
        "labelled": {"type": "integer", "minimum": 0},
        "unlabelled": {"type": "integer", "minimum": 0},
        "no_incident": {"type": "integer", "minimum": 0}
      }
    },
    "clips": {"type": "array", "items": {"$ref": "#/definitions/clip"}},
    "aggregate": {"$ref": "#/definitions/aggregate"}
  },
  "definitions": {
    "status": {
      "description": "measured = sayılar okunabilir; degraded = devirlerin beşte birinden fazlası kademe kesintisinden geldi; unmeasured = ölçülecek karar yok.",
      "enum": ["measured", "degraded", "unmeasured"]
    },
    "share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "distribution": {
      "type": "object",
      "description": "Yönlendiricinin kararlarının dağılımı; beş pay 1'e toplanır. `degraded` kesintiden gelen devirlerdir ve dört karar kovasının DIŞINDA tutulur.",
      "required": ["closed_at_router", "to_interpreter", "to_synthesizer", "escalated", "degraded"],
      "additionalProperties": false,
      "properties": {
        "closed_at_router": {"$ref": "#/definitions/share"},
        "to_interpreter": {"$ref": "#/definitions/share"},
        "to_synthesizer": {"$ref": "#/definitions/share"},
        "escalated": {"$ref": "#/definitions/share"},
        "degraded": {"$ref": "#/definitions/share"}
      }
    },
    "kpis": {
      "type": "object",
      "description": "KPI'lar. Klip kaydında o klibin değerleri, `aggregate` içinde yalnız ölçülmüş kliplerin ortalaması (token'larda toplamı).",
      "required": ["decision_distribution", "vlm_trigger_rate", "vision_tokens", "correction_propagation", "timestamp_drift_s", "turkish_output_rate", "gateway_latency", "plan_source_ratio", "risk_accuracy", "proactivity_rate", "window_outcome_distribution"],
      "additionalProperties": false,
      "properties": {
        "decision_distribution": {
          "oneOf": [{"$ref": "#/definitions/distribution"}, {"type": "null"}]
        },
        "vlm_trigger_rate": {
          "description": "Yorumlanan gözlem / toplam gözlem. Hedef: 0.05'in altı.",
          "type": ["number", "null"], "minimum": 0
        },
        "vision_tokens": {
          "description": "YALNIZ görü kademesinin token'ları, kaydedilen model kimliği başına. `tokens` sistemde tek bir yerde (Interpretation) kalıcı hâle geliyor; bu alan koşu geneli bir maliyet tablosu DEĞİLDİR.",
          "type": ["object", "null"],
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "correction_propagation": {
          "description": "Gerçek bir epizoda oturan operatör düzeltmelerinin oranı. Hiç düzeltme yoksa null — 1.0 değil.",
          "type": ["number", "null"], "minimum": 0, "maximum": 1
        },
        "timestamp_drift_s": {
          "description": "Etiketli olay başlangıcı ile en yakın tespit arasındaki medyan mutlak fark, saniye. Arşiv epizotları sayılmaz.",
          "type": ["number", "null"], "minimum": 0
        },
        "turkish_output_rate": {
          "description": "Modelin ürettiği operatör metninin Türkçe kalan oranı (süpervizör diyaloğu + epizot özetleri + risk gerekçeleri).",
          "type": ["number", "null"], "minimum": 0, "maximum": 1
        },
        "gateway_latency": {
          "description": "Gateway görü kademesi gecikme istatistikleri (ms). Hiç yorumlama yoksa null.",
          "oneOf": [
            {
              "type": "object",
              "required": ["total_ms", "mean_ms", "p50_ms", "p95_ms", "count"],
              "additionalProperties": false,
              "properties": {
                "total_ms": {"type": "number", "minimum": 0},
                "mean_ms": {"type": "number", "minimum": 0},
                "p50_ms": {"type": "number", "minimum": 0},
                "p95_ms": {"type": "number", "minimum": 0},
                "count": {"type": "integer", "minimum": 0}
              }
            },
            {"type": "null"}
          ]
        },
        "plan_source_ratio": {
          "description": "Aksiyon planlarının kaynağına göre dağılımı; paylar 1'e toplanır. Hiç plan yoksa null.",
          "oneOf": [
            {
              "type": "object",
              "required": ["model", "protocol_fallback", "empty"],
              "additionalProperties": false,
              "properties": {
                "model": {"type": "number", "minimum": 0, "maximum": 1},
                "protocol_fallback": {"type": "number", "minimum": 0, "maximum": 1},
                "empty": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            {"type": "null"}
          ]
        },
        "risk_accuracy": {
          "description": "Klipte: son risk değerlendirmesini beklenen seviyeyle karşılaştırır. Toplamda: tam isabet oranı. Null = ölçülemedi.",
          "oneOf": [
            {
              "type": "object",
              "required": ["predicted", "expected", "exact_match", "distance"],
              "additionalProperties": false,
              "properties": {
                "predicted": {"type": "string"},
                "expected": {"type": "string"},
                "exact_match": {"type": "boolean"},
                "distance": {"type": "integer"}
              }
            },
            {
              "type": "object",
              "required": ["exact_matches", "total", "accuracy"],
              "additionalProperties": false,
              "properties": {
                "exact_matches": {"type": "integer", "minimum": 0},
                "total": {"type": "integer", "minimum": 1},
                "accuracy": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            {"type": "null"}
          ]
        },
        "proactivity_rate": {
          "description": "Süpervizörün proaktif konuşma oranı. Hiç süpervizör turu yoksa null.",
          "type": ["number", "null"], "minimum": 0, "maximum": 1
        },
        "window_outcome_distribution": {
          "description": "Pencere sonuçlarının dağılımı; paylar 1'e toplanır. Hiç pencere kaydı yoksa null.",
          "oneOf": [
            {
              "type": "object",
              "required": ["routed", "forced", "skipped", "deferred"],
              "additionalProperties": false,
              "properties": {
                "routed": {"type": "number", "minimum": 0, "maximum": 1},
                "forced": {"type": "number", "minimum": 0, "maximum": 1},
                "skipped": {"type": "number", "minimum": 0, "maximum": 1},
                "deferred": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            {"type": "null"}
          ]
        }
      }
    },
    "clip": {
      "type": "object",
      "required": ["video", "status", "error", "kpis"],
      "additionalProperties": false,
      "properties": {
        "video": {"type": "string", "description": "data/ dizinine göreli yol."},
        "status": {"$ref": "#/definitions/status"},
        "error": {
          "description": "Klip çöktüyse istisna metni; koşu durmaz, kayıt kalır.",
          "type": ["string", "null"]
        },
        "kpis": {"$ref": "#/definitions/kpis"},
        "pipeline_duration_s": {
          "description": "Boru hattının bu klibi işleme süresi, saniye.",
          "type": ["number", "null"], "minimum": 0
        },
        "video_duration_s": {
          "description": "Klibin video süresi, saniye.",
          "type": ["number", "null"], "minimum": 0
        },
        "real_time_factor_e2e": {
          "description": "pipeline_duration_s / video_duration_s; 1'in altı gerçek zamandan hızlı.",
          "type": ["number", "null"], "minimum": 0
        },
        "peak_memory_mb": {
          "description": "Bu klibin işlenmesi sırasında zirve bellek kullanımı, MB.",
          "type": ["number", "null"], "minimum": 0
        },
        "summary_quality": {
          "description": "LLM-as-judge ile ölçülen özet kalitesi. Hiç özet yoksa null.",
          "oneOf": [
            {
              "type": "object",
              "required": ["completeness", "grounding", "turkish_quality", "conciseness", "mean"],
              "additionalProperties": false,
              "properties": {
                "completeness": {"type": "integer", "minimum": 1, "maximum": 5},
                "grounding": {"type": "integer", "minimum": 1, "maximum": 5},
                "turkish_quality": {"type": "integer", "minimum": 1, "maximum": 5},
                "conciseness": {"type": "integer", "minimum": 1, "maximum": 5},
                "mean": {"type": "number", "minimum": 1, "maximum": 5}
              }
            },
            {"type": "null"}
          ]
        }
      }
    },
    "aggregate": {
      "type": "object",
      "required": ["status", "clips", "kpis"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/definitions/status"},
        "clips": {
          "type": "object",
          "required": ["total", "measured", "degraded", "unmeasured", "error"],
          "additionalProperties": false,
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "measured": {"type": "integer", "minimum": 0},
            "degraded": {"type": "integer", "minimum": 0},
            "unmeasured": {"type": "integer", "minimum": 0},
            "error": {"type": "integer", "minimum": 0}
          }
        },
        "kpis": {"$ref": "#/definitions/kpis"},
        "total_pipeline_s": {
          "description": "Bütün kliplerin toplam boru hattı süresi, saniye.",
          "type": "number", "minimum": 0
        },
        "mean_pipeline_s": {
          "description": "Ortalama boru hattı süresi, saniye.",
          "type": "number", "minimum": 0
        },
        "peak_memory_mb": {
          "description": "Koşu genelinde zirve bellek kullanımı, MB.",
          "type": "number", "minimum": 0
        },
        "summary_quality": {
          "description": "Özet kalitesinin koşu geneli ortalaması.",
          "type": "object",
          "required": ["mean", "count"],
          "additionalProperties": false,
          "properties": {
            "mean": {"type": "number", "minimum": 1, "maximum": 5},
            "count": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
