.venv/
__pycache__/
*.pt
runs/
*.egg-info/
.worktrees/
.DS_Store

# YOLOE open-vocab text-encoder blob, auto-downloaded at runtime (242MB,
# over GitHub's 100MB per-file limit). Nothing in the repo references it.
mobileclip*.ts

# Yerel ortam yapılandırması; .env.example'dan kopyalanır, deploy'a özel.
.env

# litellm proxy konfigürasyonu; üretim zamanında oluşturulur, versionlanmaz.
litellm-config.yaml

# Benchmark'ın klip başına SQLite depoları: ikili ve yeniden üretilebilir.
# benchmark/results/ altındaki ölçüm çıktıları (kpi.json, grafik)
# VERSİYONLANIR — teslim kalemi onlar; yalnız depo dosyaları dışarıda kalır.
benchmark/results/stores/

# Depo kökine bırakılan video dosyaları.
*.mp4
*.mov
*.mkv

# Kök dizindeki log dosyaları.
/*.log

# Kütüphane (Hafıza ekranı): operatörün yüklediği referans belgeleri ve koşu
# bitince yazılan raporlar. İçeriği kullanıcının kendi verisi ve makineye
# özel — depo geçmişine girmez.
var/
