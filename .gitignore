*.pt
runs/
*.egg-info/
.worktrees/

# YOLOE open-vocab text-encoder blob, auto-downloaded at runtime (242MB,
# over GitHub's 100MB per-file limit). Nothing in the repo references it.
mobileclip*.ts

# Frames extracted from the Day 1 sample video by gozcu/frames.py —
# derived artifacts, regenerable; the probe scripts glob for them.
poc/day1-checkpoint/frames/
poc/day1-checkpoint/frames_64/

# Test video corpus: downloaded originals and split clips are large binaries.
# data/sources.tsv and data/*.md stay tracked; the media does not.
data/raw/
data/clips/
data/thumbs/
data/probe.tsv
data/scenes/
data/index-sheets/
data/*.log
data/broken.txt
data/.th/
data/.idx/

# Yerel ortam yapılandırması; .env.example'dan kopyalanır, deploy'a özel.
.env

# litellm proxy konfigürasyonu; scripts/gen-litellm-config.py tarafından
# üretilir. Dağıtım zamanında oluşturulur; versionlanmaz.
litellm-config.yaml
