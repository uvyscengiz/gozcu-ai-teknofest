GOZCU_GATEWAY_BASE_URL=http://localhost:4000/v1
GOZCU_GATEWAY_API_KEY=not-needed
# Tek bir gateway çağrısının saniye cinsinden zaman aşımı.
GOZCU_GATEWAY_TIMEOUT=60
# Kademe bozulmuş sayılmadan önceki toplam deneme sayısı (üstel geri çekilme).
GOZCU_GATEWAY_RETRIES=3

# Kademe → model adı. Organizasyon başka adlar deploy ederse burası yeter;
# kod tarafında model kimlikleri yalnızca gozcu/config.py'da yaşıyor.
GOZCU_MODEL_ROUTER=Qwen3-8B
GOZCU_MODEL_FAST=Qwen3.6-35B-A3B
GOZCU_MODEL_MAIN=Qwen3.5-122B-A10B
GOZCU_MODEL_VLM=Qwen3-VL-30B-A3B
GOZCU_MODEL_GUARD=Qwen3Guard-Gen-4B
GOZCU_MODEL_EMBED=Qwen3-Embedding-4B
GOZCU_MODEL_RERANK=Qwen3-Reranker-4B

# Qdrant — epizodik hafızanın vektör veritabanı. LLM ağ geçidinden AYRI:
# başka adres, başka anahtar. Erişim yolu {URL}/{PREFIX}/.
GOZCU_QDRANT_URL=https://evren-vektor.ssyz.org.tr
# Zorunlu: verilmezse istemci https şemasını yok sayıp kendi varsayılan
# portuna düşüyor ve "Connection refused" veriyor.
GOZCU_QDRANT_PORT=443
# Takım ön eki — takımlara port değil yol ön eki veriliyor, bu yüzden yalnız
# REST çalışıyor (gRPC ön ek üzerinden yönlendirilemez).
GOZCU_QDRANT_PREFIX=team37
# Vektör veritabanının kendi anahtarı (qdr-teamNN-...). Gerçek değeri buraya
# YAZMA; .env'e kopyalarken doldur.
GOZCU_QDRANT_API_KEY=
GOZCU_QDRANT_COLLECTION=episodes
# Gömme modelinin çıktı boyutu; koleksiyonu bu boyutla biz kuruyoruz.
GOZCU_QDRANT_VECTOR_SIZE=1024
GOZCU_QDRANT_TIMEOUT=600
