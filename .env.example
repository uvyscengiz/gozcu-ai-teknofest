# EVREN çıkarım servisi. Varsayılanlar gozcu/config.py'da zaten doğru;
# buradaki satırlar onları EZER, o yüzden yalnız bilerek değiştir.
GOZCU_GATEWAY_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# Takıma e-postayla gelen bearer token (sk-evren-teamNN-...). Gerçek değeri
# buraya YAZMA; .env'e kopyalarken doldur.
GOZCU_GATEWAY_API_KEY=
# Saniye. Sistem 1800 s'ye kadar çalışıyor ve her katman bu değeri kullanıyor;
# OpenAI istemcisinin 600 s varsayılanı video çağrısını modelden önce keser.
GOZCU_GATEWAY_TIMEOUT=1800
# Kademe bozulmuş sayılmadan önceki toplam deneme sayısı (üstel geri çekilme).
GOZCU_GATEWAY_RETRIES=3

# Kademe → model takma adı. **Yanlış bir ad 404 VERMEZ** — gateway isteği
# sessizce llm-fast'e yönlendirir, yani görü çağrısı bir metin modeline gider
# ve çıktı sessizce çöp olur. Adlar organizasyonun resmî listesinden.
GOZCU_MODEL_ROUTER=router
GOZCU_MODEL_FAST=llm-fast
GOZCU_MODEL_MAIN=llm-large
GOZCU_MODEL_VLM=vlm
GOZCU_MODEL_GUARD=guard
GOZCU_MODEL_EMBED=bge-m3-embed
# rerank sunuluyor ama organizasyon ÖNERMİYOR: R@1 0,95 → 0,55. Çağrılmıyor.
GOZCU_MODEL_RERANK=rerank

# Qdrant — epizodik hafızanın vektör veritabanı. LLM ağ geçidinden AYRI:
# başka adres, başka anahtar. Erişim yolu {URL}/{PREFIX}/.
GOZCU_QDRANT_URL=https://evren-vektor.ssyz.org.tr
# Zorunlu: verilmezse istemci https şemasını yok sayıp kendi varsayılan
# portuna düşüyor ve "Connection refused" veriyor.
GOZCU_QDRANT_PORT=443
# Takım ön eki — takımlara port değil yol ön eki veriliyor, bu yüzden yalnız
# REST çalışıyor (gRPC ön ek üzerinden yönlendirilemez).
GOZCU_QDRANT_PREFIX=team37
# Vektör veritabanının kendi anahtarı (qdr-teamNN-...). Gerçek değeri buraya
# YAZMA; .env'e kopyalarken doldur.
GOZCU_QDRANT_API_KEY=
GOZCU_QDRANT_COLLECTION=episodes
# Gömme modelinin çıktı boyutu; koleksiyonu bu boyutla biz kuruyoruz.
GOZCU_QDRANT_VECTOR_SIZE=1024
GOZCU_QDRANT_TIMEOUT=600
